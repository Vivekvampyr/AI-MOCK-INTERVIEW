# Django Core
SECRET_KEY=replace-with-a-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database (Option A: DATABASE_URL for Render / Supabase)
# Use Supabase Connection Pooler Session mode (Port 5432)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Database (Option B: Individual vars for local Docker dev)
DB_NAME=mock_interview
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

# CORS & CSRF (Include Vercel domain in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Clerk Authentication
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_JWT_KEY=your-clerk-jwt-key
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://your-frontend.vercel.app

# Groq AI
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# (Optional) Supabase S3-compatible Storage for Media Uploads (Recordings & Screenshots)
# In Supabase -> Settings -> Storage -> S3 Credentials
# SUPABASE_STORAGE_BUCKET=interview-media
# SUPABASE_ACCESS_KEY_ID=your-s3-access-key-id
# SUPABASE_SECRET_ACCESS_KEY=your-s3-secret-access-key
# SUPABASE_S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
# SUPABASE_REGION=us-east-1